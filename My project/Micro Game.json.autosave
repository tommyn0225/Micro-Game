Impact","\"ImpactTime\"",">=","0.10"]}],"actions":[{"type":{"value":"Delete"},"parameters":["Impact",""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["var dt = runtimeScene.getTimeManager().getElapsedTime() / 1000;","var vars = runtimeScene.getVariables();","var G = 1400;","var w = runtimeScene.getGame().getGameResolutionWidth();","var h = runtimeScene.getGame().getGameResolutionHeight();","","// Fling","function spawn(name, scale) {","  var nb = runtimeScene.createObject(name);","  if (nb) {","    if (nb.setScale) { nb.setScale(scale); } else { nb.setScaleX(scale); nb.setScaleY(scale); }","    nb.setPosition(40 + Math.random() * (w - 80), h + 60);","    nb.vx = -300 + Math.random() * 600;","    nb.vy = -(800 + Math.random() * 450);","    nb.spin = -220 + Math.random() * 440;","  }","}","","// Random spawn timer","function tick(accKey, nextKey, name, scale) {","  var acc = vars.get(accKey).getAsNumber() + dt;","  var next = vars.get(nextKey).getAsNumber();","  if (next <= 0) next = 1.0 + Math.random() * 1.4;","  if (acc >= next) { acc -= next; next = 1.0 + Math.random() * 1.4; spawn(name, scale); }","  vars.get(accKey).setNumber(acc);","  vars.get(nextKey).setNumber(next);","}","tick(\"accBarrel\", \"nextBarrel\", \"Red_barrel\", 1);","tick(\"accBird\", \"nextBird\", \"FatBarrel\", 2.5);","","function physics(name) {","  var arr = runtimeScene.getObjects(name);","  for (var i = arr.length - 1; i >= 0; i--) {","    var b = arr[i];","    if (typeof b.vy !== \"number\") { b.vx = 0; b.vy = 0; b.spin = 60; }","    b.vy += G * dt;","    b.setX(b.getX() + b.vx * dt);","    b.setY(b.getY() + b.vy * dt);","    b.setAngle(b.getAngle() + b.spin * dt);","    if (b.getY() > h + 200) { b.deleteFromScene(runtimeScene); }","  }","}","physics(\"Red_barrel\");","physics(\"FatBarrel\");","","var im = runtimeScene.getGame().getInputManager();","var down = im.isMouseButtonPressed(0);","var wasDown = vars.get(\"mouseWasDown\").getAsNumber() === 1;","if (down && !wasDown) {","  var cx = gdjs.evtTools.input.getCursorX(runtimeScene, \"\", 0);","  var cy = gdjs.evtTools.input.getCursorY(runtimeScene, \"\", 0);","  function hit(name, pts) {","    var arr = runtimeScene.getObjects(name);","    for (var j = arr.length - 1; j >= 0; j--) {","      var t = arr[j];","      if (t.insideObject(cx, cy)) {","        vars.get(\"Score\").setNumber(vars.get(\"Score\").getAsNumber() + pts);","        t.deleteFromScene(runtimeScene);","      }","    }","  }","  hit(\"FatBarrel\", 10);","  hit(\"Red_barrel\", -10);","}","vars.get(\"mouseWasDown\").setNumber(down ? 1 : 0);","","// Update the score text","var txts = runtimeScene.getObjects(\"NewText\");","if (txts.length > 0) { txts[0].setString(\"Score: \" + vars.get(\"Score\").getAsNumber()); }",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[]},{"aiGeneratedEventId":"01KT815V2JF4PGR6PCX1KWKXN2","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"ResetTimer"},"parameters":["","\"GameTimer\""]}]},{"aiGeneratedEventId":"01KT8162SB23X3TRN61B944S5D","type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"GameTimer\"",">=","GameTimerDuration"]}],"actions":[{"type":{"value":"Quit"},"parameters":[""]}]}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"widt